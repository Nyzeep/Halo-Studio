{
  "name": "halo-studio",
  "private": true,
  "version": "0.2.14",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "copy-monaco": "copyfiles -u 5 \"src/web-ui/node_modules/monaco-editor/min/vs/**/*\" src/web-ui/public/monaco-editor && node scripts/prune-monaco-nls.cjs",
    "copy-icons": "copyfiles -f \"src/apps/desktop/icons/Logo-ICON.png\" \"src/web-ui/public/\"",
    "copy-assets": "pnpm run copy-monaco && pnpm run copy-icons",
    "generate-version": "node scripts/generate-version.cjs",
    "generate-startup-theme-bootstrap": "node scripts/generate-startup-theme-bootstrap.mjs",
    "generate-all": "pnpm run generate-version && pnpm run generate-startup-theme-bootstrap",
    "postinstall": "node scripts/halo-scope.mjs",
    "dev": "node scripts/halo-tauri.mjs dev",
    "lint:web": "pnpm --dir src/web-ui run lint",
    "lint:web:fix": "pnpm --dir src/web-ui run lint:fix",
    "i18n:generate": "node scripts/generate-i18n-contract.mjs",
    "i18n:contract:test": "node --test scripts/i18n-contract.test.mjs",
    "i18n:contract:test:ci": "cross-env HALO_I18N_CONTRACT_TEST_PROFILE=ci node --test scripts/i18n-contract.test.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "theme:color-audit": "node scripts/audit-theme-colors.mjs",
    "theme:color-audit:mobile": "node scripts/audit-theme-colors.mjs --root src/mobile-web/src --baseline scripts/theme-color-governance-baseline.mobile-web.json",
    "theme:color-audit:installer": "node scripts/audit-theme-colors.mjs --root Halo-Installer/src --baseline scripts/theme-color-governance-baseline.installer.json",
    "theme:color-audit:cli": "node scripts/audit-cli-theme-colors.mjs",
    "theme:color-audit:all": "pnpm run theme:color-audit && pnpm run theme:color-audit:mobile && pnpm run theme:color-audit:installer && pnpm run theme:color-audit:cli",
    "theme:color-audit:test": "node --test scripts/audit-theme-colors.test.mjs scripts/audit-cli-theme-colors.test.mjs",
    "theme:visual-contract": "node scripts/validate-theme-visual-contract.mjs",
    "check:repo-hygiene": "node scripts/check-repo-hygiene.mjs && node scripts/verify-old-six-behavior-equivalence.mjs",
    "verify:old-six-behavior-equivalence": "node --test scripts/verify-old-six-behavior-equivalence.test.mjs && node scripts/verify-old-six-behavior-equivalence.mjs",
    "check:github-config": "pnpm --dir src/web-ui exec node ../../scripts/check-github-config.mjs && node --test scripts/check-github-config.test.mjs",
    "fmt:rs": "node scripts/format-changed-rust.mjs",
    "lint:rs": "cargo clippy --workspace --exclude halo-desktop --all-targets",
    "lint:rs:desktop": "cargo clippy -p halo-tauri-desktop --all-targets",
    "lint:rs:installer": "cargo clippy --manifest-path Halo-Installer/src-tauri/Cargo.toml --all-targets",
    "lint:rs:all": "pnpm run lint:rs && pnpm run lint:rs:desktop && pnpm run lint:rs:installer",
    "prebuild": "node scripts/halo-scope.mjs",
    "type-check:web": "pnpm --dir src/web-ui run type-check",
    "build": "node scripts/halo-tauri.mjs build",
    "desktop:dev": "node scripts/halo-tauri.mjs dev",
    "desktop:preview:debug": "node scripts/halo-web-ui-preview.mjs",
    "desktop:dev:raw": "node scripts/halo-tauri.mjs dev",
    "target:gc": "node scripts/cargo-target-gc.mjs",
    "product:check": "node scripts/product-customization/cli.mjs check",
    "product:explain": "node scripts/product-customization/cli.mjs explain",
    "product:test": "node --test --test-concurrency=1 scripts/check-repo-hygiene.test.mjs scripts/product-customization/*.test.mjs scripts/cli-product.test.mjs scripts/desktop-tauri-build.test.mjs",
    "desktop:build": "node scripts/halo-tauri.mjs build",
    "desktop:build:fast": "node scripts/halo-tauri.mjs build --debug --no-bundle",
    "desktop:build:release-fast": "node scripts/halo-tauri.mjs build --no-bundle --profile release-fast",
    "desktop:build:exe": "node scripts/halo-tauri.mjs build --no-bundle",
    "desktop:build:nsis": "node scripts/halo-tauri.mjs build --bundles nsis",
    "desktop:build:nsis:fast": "node scripts/halo-tauri.mjs build --bundles nsis --profile release-fast",
    "desktop:build:arm64": "node scripts/halo-tauri.mjs build --target aarch64-apple-darwin --bundles app,dmg",
    "desktop:build:x86_64": "node scripts/halo-tauri.mjs build --target x86_64-apple-darwin --bundles app,dmg",
    "desktop:build:linux": "node scripts/halo-tauri.mjs build",
    "desktop:build:linux:deb": "node scripts/halo-tauri.mjs build --bundles deb",
    "desktop:build:linux:rpm": "node scripts/halo-tauri.mjs build --bundles rpm",
    "desktop:build:linux:appimage": "node scripts/halo-tauri.mjs build --bundles appimage",
    "cli:dev": "node scripts/cli-product.mjs dev",
    "cli:build": "node scripts/cli-product.mjs build",
    "cli:install": "node scripts/install-cli.mjs",
    "cli:install:unix": "bash src/apps/cli/install.sh",
    "cli:install:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src/apps/cli/install.ps1",
    "cli:run": "cd src/apps/cli && cargo run --release --",
    "cli:exec": "cd src/apps/cli && cargo run -- exec",
    "cli:check": "cd src/apps/cli && cargo check",
    "cli:test": "cd src/apps/cli && cargo test",
    "website:dev": "pnpm --dir website run dev",
    "website:build": "pnpm --dir website run build",
    "website:preview": "pnpm --dir website run preview",
    "website:install": "pnpm --dir website install",
    "e2e:install": "pnpm --dir tests/e2e install",
    "e2e:test": "cross-env HALO_E2E_APP_MODE=debug pnpm --dir tests/e2e test",
    "e2e:test:l0": "cross-env HALO_E2E_APP_MODE=debug pnpm --dir tests/e2e run test:l0",
    "e2e:test:l0:all": "cross-env HALO_E2E_APP_MODE=debug pnpm --dir tests/e2e run test:l0:all",
    "e2e:test:l1": "cross-env HALO_E2E_APP_MODE=debug pnpm --dir tests/e2e run test:l1",
    "e2e:test:smoke": "cross-env HALO_E2E_APP_MODE=debug pnpm --dir tests/e2e run test:smoke",
    "e2e:test:chat": "cross-env HALO_E2E_APP_MODE=debug pnpm --dir tests/e2e run test:chat",
    "e2e:test:perf:debug": "cross-env HALO_E2E_APP_MODE=debug E2E_LOG_LEVEL=warn pnpm --dir tests/e2e run test:perf",
    "e2e:test:perf:release-fast": "cross-env HALO_E2E_APP_MODE=release-fast E2E_LOG_LEVEL=warn pnpm --dir tests/e2e run test:perf",
    "e2e:test:perf:startup-stability:release-fast": "cross-env HALO_E2E_APP_MODE=release-fast E2E_LOG_LEVEL=warn node tests/e2e/scripts/run-startup-stability.mjs",
    "e2e:test:perf:long-session-interactions:release-fast": "cross-env HALO_E2E_APP_MODE=release-fast E2E_LOG_LEVEL=warn node tests/e2e/scripts/run-long-session-interaction-matrix.mjs"
  },
  "devDependencies": {
    "@noble/hashes": "^2.0.1",
    "@tauri-apps/cli": "^2.10.0",
    "@vitejs/plugin-react": "^4.6.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "sass": "^1.93.2",
    "sharp": "^0.34.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b",
  "dependencies": {
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pnpm": "^10.32.1",
    "pptxgenjs": "^4.0.1"
  }
}
