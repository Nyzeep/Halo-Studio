{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halo Studio",
  "version": "0.1.0",
  "identifier": "com.halostudio.desktop",
  "build": {
    "beforeDevCommand": "node ../../scripts/halo-web-ui-dev-server.mjs",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "node ../../scripts/halo-web-ui-build.mjs",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Halo Studio - 本地编码工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 650,
        "resizable": true,
        "visible": true,
        "create": false
      }
    ],
    "security": {
      "capabilities": ["halo-default"],
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Halo Studio 本地编码工作台",
    "longDescription": "Halo Studio 是面向本地代码工作流的 Tauri 编码工作台。",
    "icon": [
      "icons/halo-icon.icns",
      "icons/halo-icon.ico",
      "icons/halo-icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
