{
  "schemaVersion": 1,
  "productId": "halo-studio",
  "displayName": "Halo Studio",
  "bundleIdentifier": "com.halostudio.desktop",
  "binaryName": "halo-studio",
  "desktopRoot": "src/apps/halo-desktop",
  "frontendRoot": "src/web-ui",
  "tauriConfig": "src/apps/halo-desktop/tauri.conf.json",
  "developmentEntry": "node scripts/halo-tauri.mjs dev",
  "packagingEntry": "node scripts/halo-tauri.mjs build",
  "includedModules": [
    "local-workspaces",
    "coding-sessions",
    "file-explorer",
    "editor",
    "git",
    "terminal"
  ],
  "excludedModules": [
    "office-collaboration",
    "mini-app",
    "remote-workspace",
    "relay",
    "mobile-client"
  ],
  "excludedRoutes": [
    "dev:mobile-web",
    "dev:miniapp-market",
    "dev:mobile-web:host",
    "dev:web",
    "preview:mobile-web",
    "preview",
    "preview-components",
    "type-check:mobile-web",
    "test:ppt-live",
    "build:mobile-web",
    "build:miniapp-market",
    "type-check:miniapp-market",
    "test:miniapp-market",
    "prepare:mobile-web",
    "frontend:build-all",
    "prebuild:web",
    "build:web",
    "build-components",
    "verify:monaco-assets",
    "build:relay-page-auth",
    "type-check:relay-page-auth",
    "test:relay-page-auth",
    "installer:build",
    "installer:build:fast",
    "installer:build:only",
    "installer:build:only:fast",
    "installer:dev"
  ],
  "runtimePolicy": {
    "workspaceMode": "local-only",
    "remoteConnections": false,
    "relayServices": false,
    "mobileResources": false,
    "miniAppRuntime": false,
    "officeCollaboration": false
  }
}
