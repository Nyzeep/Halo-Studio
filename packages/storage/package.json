{
  "name": "@halo-studio/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run build --workspace @halo-studio/contracts && npm run build --workspace @halo-studio/core",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build --workspace @halo-studio/contracts && npm run build --workspace @halo-studio/core",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build --workspace @halo-studio/contracts && npm run build --workspace @halo-studio/core",
    "test": "vitest run"
  },
  "dependencies": {
    "@halo-studio/contracts": "0.1.0",
    "@halo-studio/core": "0.1.0",
    "better-sqlite3": "11.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.10.5",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.18"
  }
}
